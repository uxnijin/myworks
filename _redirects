# Rewrite subdomain traffic to the tints-and-shades subdirectory (200 Rewrite/Proxy)
https://tintsandshades.nijin.site/*  /tints-and-shades/:splat  200
http://tintsandshades.nijin.site/*   /tints-and-shades/:splat  200

# Edge redirects for migrated landing, privacy, and terms pages
/design-system-extractor/privacy.html  /docs/design-system-extractor/privacy  301
/design-system-extractor/terms.html    /docs/design-system-extractor/terms    301
/design-system-extractor               /docs/design-system-extractor          301
/design-system-extractor/              /docs/design-system-extractor          301

/tasks/privacy.html                    /docs/tasks-extension/privacy          301
/tasks/terms.html                      /docs/tasks-extension/terms            301
/tasks                                 /docs/tasks-extension                  301
/tasks/                                /docs/tasks-extension                  301

# Tints & Shades never had a privacy or terms body of its own, so these two
# used to 301 onto a page that does not exist. They point at the product now.
/tints-and-shades/privacy.html         /docs/tints-and-shades                 301
/tints-and-shades/terms.html           /docs/tints-and-shades                 301
/tints-and-shades                      /docs/tints-and-shades                 301
/tints-and-shades/                     /docs/tints-and-shades                 301

# /projects was renamed to /products. Exact paths only — no splat — because
# /projects/<name>.js are real source files that must keep resolving.
/projects                              /products                              301
/projects/                             /products                              301

# /writings was renamed to /findings. Splat too — an article keeps its slug,
# so /writings/<slug> maps straight onto /findings/<slug>.
/writings                              /findings                              301
/writings/                             /findings                              301
/writings/*                            /findings/:splat                       301

# /hire was folded into /contact: a sales page sitting beside the contact page
# was one page too many, and the two competed for the same visitor. Everything
# that page answered is on /contact now, so every phrasing points there.
/hire                                  /contact                               301
/hire/                                 /contact                               301
/services                              /contact                               301
/services/                             /contact                               301
/freelance                             /contact                               301
/hire-me                               /contact                               301
/ui-ux-designer                        /contact                               301

# /exploring is gone — the toolkit it listed is now the Tools row on /about.
/exploring                             /about                                 301
/exploring/                            /about                                 301

# Oppam grew out of a design entry into a case study. The old URL has been
# shared, so it moves rather than dying.
/designs/oppam                         /case-studies/oppam                    301
/designs/oppam/                        /case-studies/oppam                    301

# SPA fallback for the docs router (/docs/<slug>).
# Netlify serves matching static files first, so the real product directories
# (/tasks/, /design-system-extractor/, /tints-and-shades/) keep resolving normally.
# Keep this rule LAST, it is the catch-all.
/*  /index.html  200
